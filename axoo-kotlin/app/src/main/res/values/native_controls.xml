<resources>
    <!-- Scoped to standard controls; the Activity keeps its platform theme. -->
    <style name="Theme.Axoo.Controls" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/axoo_accent</item>
        <item name="colorOnPrimary">@color/axoo_on_accent</item>
        <item name="colorSurface">@color/axoo_card</item>
        <item name="colorOnSurface">@color/axoo_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/axoo_text_secondary</item>
        <item name="tabStyle">@style/Widget.Axoo.FeedTabs</item>
    </style>
    <style name="Widget.Axoo.FeedTabs" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.Axoo.FeedTab</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabPaddingStart">8dp</item>
        <item name="tabPaddingEnd">8dp</item>
    </style>
    <style name="TextAppearance.Axoo.Navigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Axoo.FeedTab" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/baloo2_extra_bold</item>
        <item name="android:fontFamily">@font/baloo2_extra_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
